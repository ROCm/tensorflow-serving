From debc66cdcd4ca1a50c912b274244b1be5d5533c1 Mon Sep 17 00:00:00 2001
From: root <root@smc300x-clt-r4c6-18.cs-clt.dcgpu>
Date: Thu, 19 Dec 2024 18:35:11 +0000
Subject: [PATCH] Turn off cholesky

---
 tensorflow/core/kernels/linalg/BUILD | 11 -----------
 1 file changed, 11 deletions(-)

diff --git a/tensorflow/core/kernels/linalg/BUILD b/tensorflow/core/kernels/linalg/BUILD
index 79c58634be6..6ae531bf4bd 100644
--- a/tensorflow/core/kernels/linalg/BUILD
+++ b/tensorflow/core/kernels/linalg/BUILD
@@ -27,7 +27,6 @@ package_group(

 # Export a few files for use on Android.
 exports_files([
-    "cholesky_op.cc",
     "determinant_op.cc",
     "einsum_op_impl_half.cc",
     "einsum_op_impl_bfloat16.cc",
@@ -66,7 +65,6 @@ cc_library(
     deps = [
         ":banded_triangular_solve_op",
         ":cholesky_grad",
-        ":cholesky_op",
         ":determinant_op",
         ":eig_op",
         ":einsum_op",
@@ -124,15 +122,6 @@ tf_kernel_library(
     deps = LINALG_DEPS + [":matrix_diag_op"],
 )

-tf_kernel_library(
-    name = "cholesky_op",
-    gpu_deps = ["//tensorflow/core/platform:stream_executor"],
-    prefix = "cholesky_op",
-    deps = if_cuda_or_rocm([
-        ":matrix_band_part_op",
-    ]) + LINALG_DEPS,
-)
-
 tf_kernel_library(
     name = "cholesky_grad",
     prefix = "cholesky_grad",
--
2.34.1
